{
  "manifest_version": 3,
  "name": "OCR Trabajo · Autocarpe",
  "version": "0.2.0",
  "description": "Reconoce las pestañas de un expediente y aplica reglas locales a texto, opciones, conmutadores y adjuntos.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://intranet.autocarpe.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://intranet.autocarpe.com/*"
      ],
      "js": [
        "form.js"
      ]
    },
    {
      "matches": [
        "https://gpt2026.vercel.app/ocrtrabajo/*",
        "https://gpt2026.vercel.app/ocrtrabajo"
      ],
      "js": [
        "bridge.js"
      ]
    }
  ]
}
